{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["on Monday"],
  "updateNotScheduled": false,
  "reviewers": ["evanjamesjackson"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["custom.regex"],
      "pinDigests": true,
      "groupName": "Services VM Docker images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^roles/.+/tasks/.*\\.ya?ml$"],
      "matchStrings": ["image:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@sha256:(?<currentDigest>[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
